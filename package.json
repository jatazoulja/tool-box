{
  "name": "converter",
  "private": true,
  "version": "0.1.0",
  "homepage": "https://jatazoulja.github.io/tool-box/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode development",
    "dev:dev": "vite --mode dev",
    "dev:prod": "vite --mode prod",
    "build": "tsc -b && vite build --mode prod",
    "build:local": "tsc -b && vite build --mode development",
    "build:dev": "tsc -b && vite build --mode dev",
    "build:prod": "tsc -b && vite build --mode prod",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview --mode prod",
    "preview:local": "vite preview --mode development",
    "preview:dev": "vite preview --mode dev",
    "preview:prod": "vite preview --mode prod"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.8.0",
    "@emotion/react": "^11.14.0",
    "lucide-react": "^0.475.0",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.8.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.8.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
